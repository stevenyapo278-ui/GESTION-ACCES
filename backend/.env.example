# Database
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/gestions_access

# JWT — Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_EXPIRES_IN=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=gestions-access-uploads

# Server
PORT=3001
CORS_ORIGIN=http://localhost:8888
NODE_ENV=development

# Email (Outlook/M365 via Graph API OAuth2, ou SMTP générique — configuré dans l'app : page admin "Comptes email")
# URL publique du frontend, utilisée pour les liens de validation envoyés par email (override en base via l'admin)
FRONTEND_URL=http://localhost:8888
# URI de callback OAuth Microsoft (par défaut : {FRONTEND_URL}/api/oauth/outlook/callback)
# MICROSOFT_REDIRECT_URI=http://localhost:8888/api/oauth/outlook/callback
# Adresse email qui reçoit les notifications de décision (override en base via l'admin)
# NOTIFICATION_EMAIL=admin@example.com
